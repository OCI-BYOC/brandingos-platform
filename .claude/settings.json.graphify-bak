{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(gh:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(echo:*)",
      "Bash(wrangler:*)",
      "Bash(drizzle-kit:*)",
      "Bash(turbo:*)"
    ],
    "deny": [
      "Bash(curl:* production*)",
      "Bash(rm:-rf /)",
      "Bash(sudo:*)"
    ]
  },
  "model": "claude-sonnet-4-6",
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": true
}
