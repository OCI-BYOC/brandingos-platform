# Neon PostgreSQL — same DB as the main platform
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Redis — required for Medusa events/jobs
REDIS_URL=redis://localhost:6379

# Medusa server
BACKEND_URL=http://localhost:9000
JWT_SECRET=change_me_in_production
COOKIE_SECRET=change_me_in_production

# CORS — allow web app and store front end
STORE_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:3001

# Set to "true" to disable the built-in Medusa admin panel
DISABLE_MEDUSA_ADMIN=false
