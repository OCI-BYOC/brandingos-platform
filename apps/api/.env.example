# Neon PostgreSQL — same DB as the main platform
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Redis — required for Medusa events/jobs
REDIS_URL=redis://localhost:6379

# Medusa server
BACKEND_URL=http://localhost:9000
JWT_SECRET=change_me_in_production
COOKIE_SECRET=change_me_in_production

# CORS — allow web app and store front end
STORE_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:3001

# Set to "true" to disable the built-in Medusa admin panel
DISABLE_MEDUSA_ADMIN=false

# ── Payment Providers ──────────────────────────────────────────────────────

# Razorpay — India (UPI, Cards, Wallets, Net Banking)
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe — International (Cards, Apple Pay, Google Pay, SEPA)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Fulfillment Providers ──────────────────────────────────────────────────

# ShipRocket — 25+ courier partners, India-first domestic + international
# Signup: https://app.shiprocket.in/register
SHIPROCKET_EMAIL=your@email.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# EasyShip — 550+ couriers globally (US, EU, Asia, rest of world)
# Signup: https://app.easyship.com/signup
EASYSHIP_API_KEY=your_easyship_api_key
EASYSHIP_ACCOUNT_ID=your_easyship_account_id
