# ── Clerk ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database (Neon) ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ── Medusa backend ────────────────────────────────────────────────────────────
# URL of the running Medusa API server (apps/api)
MEDUSA_BACKEND_URL=http://localhost:9000
# Must match NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY from your Medusa admin panel
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Internal service key — must match MEDUSA_SERVICE_KEY in apps/api/.env exactly
# Ask a teammate for the real value; never commit the actual key
MEDUSA_SERVICE_KEY=generate_a_random_64char_hex_string
