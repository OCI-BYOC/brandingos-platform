{
  "name": "@brandingos/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "node --require tsx/cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --require tsx/cjs ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --require tsx/cjs ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --require tsx/cjs ./node_modules/drizzle-kit/bin.cjs studio",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
